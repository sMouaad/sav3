---
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '../styles/global.css';
import fontLatin from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MaintenanceNotice from '../components/MaintenanceNotice.astro'; // TEMPORARY MAINTENANCE NOTICE - remove after update
import { useT } from '../i18n';
import { htmlLang, ogLocale, otherLang, path, routes, type Lang, type RouteKey } from '../i18n/routes';
import { breadcrumbLd } from '../lib/seo';

interface Props {
  lang: Lang;
  routeKey: RouteKey;
  title: string;
  description: string;
  noindex?: boolean;
  /** Fil d'Ariane (hors accueil) — génère aussi le JSON-LD BreadcrumbList. */
  breadcrumbs?: { name: string; href: string }[];
  jsonLd?: object[];
}

const { lang, routeKey, title, description, noindex = false, breadcrumbs, jsonLd = [] } = Astro.props;
const t = useT(lang);
const origin = (Astro.site ?? new URL('http://localhost:4321')).origin;
const canonical = new URL(routes[routeKey][lang], origin).href;
const alternates = (['fr', 'en'] as const).map((l) => ({ hreflang: htmlLang[l], href: new URL(routes[routeKey][l], origin).href }));
const isErrorPage = routeKey === 'notFound';
const ogImage = `${origin}/og-image-${lang}.jpg`;

const ld = [...jsonLd];
if (breadcrumbs?.length) {
  ld.push(breadcrumbLd([{ name: t.common.home, href: path('home', lang) }, ...breadcrumbs], origin));
}
---

<!doctype html>
<html lang={htmlLang[lang]} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    {!isErrorPage && <link rel="canonical" href={canonical} />}
    {!isErrorPage && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {!isErrorPage && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}

    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.meta.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[otherLang(lang)]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />

    {ld.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <MaintenanceNotice />{/* TEMPORARY MAINTENANCE NOTICE - remove after update */}
    <a class="skip-link" href="#contenu">{t.common.skip}</a>
    <Header lang={lang} routeKey={routeKey} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} routeKey={routeKey} />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
