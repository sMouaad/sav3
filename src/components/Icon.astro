---
/**
 * Icônes Lucide (licence ISC) rendues en SVG au moment du build : aucun JavaScript, aucune requête.
 * Pour ajouter une icône : l'importer depuis 'lucide' et l'ajouter à la table ci-dessous.
 */
import {
  AppWindow, ArrowLeft, ArrowRight, ArrowUp, Briefcase, Building, Building2, CalendarCheck, Check, CircleCheck,
  ClipboardCheck, Clock, Droplets, Ellipsis, Globe, HardHat, House, Info, KeyRound, Layers, Lock, Mail, MapPin,
  Menu, PaintRoller, Phone, Send, ShieldCheck, SlidersHorizontal, Sparkles, SprayCan, Stethoscope, Store,
  TriangleAlert, Truck, UserCheck, Warehouse, Waves, X,
} from 'lucide';

const icons = {
  arrowLeft: ArrowLeft, arrowRight: ArrowRight, arrowUp: ArrowUp, briefcase: Briefcase, building: Building2,
  buildings: Building, calendar: CalendarCheck, check: Check, checkCircle: CircleCheck, clipboard: ClipboardCheck,
  clock: Clock, droplets: Droplets, globe: Globe, hardHat: HardHat, house: House, info: Info, key: KeyRound,
  layers: Layers, lock: Lock, mail: Mail, mapPin: MapPin, menu: Menu, more: Ellipsis, paintRoller: PaintRoller,
  phone: Phone, send: Send, shield: ShieldCheck, sliders: SlidersHorizontal, sparkles: Sparkles, sprayCan: SprayCan,
  stethoscope: Stethoscope, store: Store, truck: Truck, userCheck: UserCheck, warehouse: Warehouse, warning: TriangleAlert,
  waves: Waves, window: AppWindow, x: X,
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName | (string & {});
  size?: number;
  strokeWidth?: number;
  class?: string;
  label?: string;
}

const { name, size = 24, strokeWidth = 1.75, class: className, label } = Astro.props;
const node = icons[name as IconName];
if (!node) throw new Error(`Icône inconnue : « ${name} ». Ajoutez-la dans src/components/Icon.astro.`);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
>
  {node.map(([Tag, attrs]) => <Tag {...attrs} />)}
</svg>
