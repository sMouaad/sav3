---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { useT } from '../i18n';
import { otherLang, path, routes, type Lang, type RouteKey } from '../i18n/routes';
import { site, telHref } from '../config/site';

interface Props {
  lang: Lang;
  routeKey: RouteKey;
}
const { lang, routeKey } = Astro.props;
const t = useT(lang);
const alt = otherLang(lang);
const switchHref = routes[routeKey][alt];

const links = [
  { label: t.nav.services, href: path('services', lang), current: routeKey === 'services' },
  { label: t.nav.sectors, href: path('home', lang, t.anchors.sectors) },
  { label: t.nav.method, href: path('home', lang, t.anchors.method) },
  { label: t.nav.about, href: path('home', lang, t.anchors.about) },
  { label: t.nav.careers, href: path('careers', lang), current: routeKey === 'careers' },
];
const phone = site.contact.phone;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href={path('home', lang)} aria-label={t.common.homeAria}>
      <Logo />
    </a>

    <nav id="site-menu" class="site-nav" popover aria-label={t.common.mainNav}>
      <div class="site-nav__top">
        <Logo />
        <button class="icon-btn" type="button" popovertarget="site-menu" popovertargetaction="hide">
          <Icon name="x" />
          <span class="visually-hidden">{t.common.closeMenu}</span>
        </button>
      </div>
      <ul class="site-nav__list" role="list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={link.current ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="site-nav__extra">
        {
          phone && (
            <a class="btn btn--ghost btn--block" href={telHref(phone)}>
              <Icon name="phone" />
              {phone}
            </a>
          )
        }
        <a class="btn btn--block btn--lg" href={path('quote', lang)}>
          {t.common.requestQuote}
          <Icon name="arrowRight" />
        </a>
      </div>
    </nav>

    <div class="site-header__actions">
      {
        phone && (
          <a class="site-header__phone" href={telHref(phone)}>
            <Icon name="phone" size={18} />
            {phone}
          </a>
        )
      }
      <a class="lang-switch" href={switchHref} hreflang={alt} lang={alt}>
        <Icon name="globe" size={18} />
        <span>{t.common.lang.short}</span>
        <span class="visually-hidden"> – {t.common.lang.aria}</span>
      </a>
      <a class="btn site-header__cta" href={path('quote', lang)} aria-current={routeKey === 'quote' ? 'page' : undefined}>
        {t.common.quoteCta}
        <Icon name="arrowRight" />
      </a>
      <button class="icon-btn menu-toggle" type="button" popovertarget="site-menu" aria-controls="site-menu">
        <Icon name="menu" />
        <span class="visually-hidden">{t.common.menu}</span>
      </button>
    </div>
  </div>
</header>

<script>
  import '../scripts/nav';
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.86);
    border-bottom: 1px solid transparent;
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    backdrop-filter: saturate(1.6) blur(14px);
  }
  /* Ombre progressive au défilement (CSS uniquement) */
  @keyframes header-raise {
    to {
      background: rgb(255 255 255 / 0.97);
      border-bottom-color: var(--line);
      box-shadow: 0 6px 24px -12px rgb(11 30 66 / 0.25);
    }
  }
  @supports (animation-timeline: scroll()) {
    .site-header {
      animation: header-raise linear both;
      animation-timeline: scroll(root);
      animation-range: 0 140px;
    }
  }
  @supports not (animation-timeline: scroll()) {
    .site-header {
      border-bottom-color: var(--line);
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: var(--header-h);
  }
  .site-header__brand {
    flex: none;
    border-radius: 8px;
    text-decoration: none;
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }
  .site-header__phone {
    display: none;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.6rem;
    color: var(--navy-800);
    font-size: var(--fs-sm);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .site-header__cta {
    display: none;
  }
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    color: var(--navy-800);
    font-size: var(--fs-xs);
    font-weight: 750;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: background-color 0.2s var(--ease);
  }
  .lang-switch:hover {
    background: var(--surface-3);
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1.5px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--navy-900);
  }
  .icon-btn:hover {
    border-color: var(--navy-800);
  }
  .icon-btn :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }

  /* ----- Menu mobile : panneau plein écran (popover) ----- */
  .site-nav {
    position: fixed;
    z-index: 100;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0 var(--gutter) 2rem;
    border: 0;
    background: var(--surface);
    color: var(--ink);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .site-nav:popover-open,
  .site-nav.is-open {
    display: flex;
    flex-direction: column;
    opacity: 1;
    transform: none;
  }
  /* Repli sans API Popover (voir scripts/nav.ts) */
  @media (max-width: 63.99em) {
    .site-nav:not([popover]):not(.is-open) {
      display: none;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .site-nav {
      transition:
        opacity 0.25s var(--ease),
        transform 0.3s var(--ease),
        overlay 0.3s allow-discrete,
        display 0.3s allow-discrete;
      opacity: 0;
      transform: translateY(-0.75rem);
    }
    .site-nav:popover-open {
      opacity: 1;
      transform: none;
    }
    @starting-style {
      .site-nav:popover-open {
        opacity: 0;
        transform: translateY(-0.75rem);
      }
    }
  }
  .site-nav::backdrop {
    background: rgb(6 18 43 / 0.4);
  }
  .site-nav__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    margin-bottom: 1rem;
  }
  .site-nav__list {
    display: grid;
  }
  .site-nav__list a {
    display: flex;
    align-items: center;
    padding: 1rem 0.25rem;
    border-bottom: 1px solid var(--line);
    color: var(--navy-900);
    font-size: 1.35rem;
    font-weight: 750;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .site-nav__list a[aria-current='page'] {
    color: var(--blue-600);
  }
  .site-nav__extra {
    display: grid;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 2rem;
  }

  /* ----- Bureau : navigation en ligne ----- */
  @media (min-width: 64em) {
    .menu-toggle,
    .site-nav__top,
    .site-nav__extra {
      display: none;
    }
    .site-header__cta {
      display: inline-flex;
    }
    .site-nav {
      display: block;
      position: static;
      inset: auto;
      width: auto;
      height: auto;
      margin: 0 0 0 auto;
      padding: 0;
      background: none;
      overflow: visible;
      opacity: 1;
      transform: none;
    }
    .site-nav__list {
      display: flex;
      gap: 0.25rem;
    }
    .site-nav__list a {
      position: relative;
      padding: 0.55rem 0.8rem;
      border: 0;
      border-radius: 999px;
      color: var(--ink-2);
      font-size: var(--fs-sm);
      font-weight: 650;
      letter-spacing: 0;
      transition:
        background-color 0.2s var(--ease),
        color 0.2s var(--ease);
    }
    .site-nav__list a:hover {
      background: var(--surface-3);
      color: var(--navy-900);
    }
    .site-nav__list a[aria-current='page'] {
      color: var(--navy-900);
      background: var(--blue-50);
    }
    .site-header__actions {
      margin-left: 0.5rem;
    }
  }
  @media (min-width: 80em) {
    .site-header__phone {
      display: inline-flex;
    }
  }
</style>
