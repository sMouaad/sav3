---
/**
 * ─────────────────────────────────────────────────────────────────────────────
 *  TEMPORARY MAINTENANCE NOTICE - remove after update
 * ─────────────────────────────────────────────────────────────────────────────
 *  Page « site en maintenance » bilingue (FR puis EN). Quand le drapeau est actif,
 *  BaseLayout n'affiche QUE cette page : en-tête, contenu et pied de page ne sont
 *  pas générés, le site n'est donc pas accessible. Aucun JavaScript.
 *  - Désactiver : `maintenanceNotice: false` dans src/config/site.ts.
 *  - Retirer : supprimer ce fichier ; dans src/layouts/BaseLayout.astro, retirer les
 *    deux imports et les deux lignes marqués TEMPORARY MAINTENANCE NOTICE autour du
 *    contenu (garder le contenu) ; puis la clé `maintenanceNotice` de site.ts.
 *  - Couleurs : variables --mn-* en tête du bloc <style> ci-dessous.
 *
 *  Le robot est un SVG en ligne animé en CSS pur. Aucun attribut style="" :
 *  la Content-Security-Policy du site (style-src 'self') les bloquerait.
 */
---

<main id="contenu" class="maintenance-notice">
  <div class="maintenance-notice__inner">
    <span class="maintenance-notice__logo">
      <img class="maintenance-notice__symbol" src="/brand/symbol.svg" alt="" width="1636" height="1798" />
      {/* « SAV3 » = logotype officiel ; « GROUP » = lettres tracées dans le même style (même hauteur, épaisseur, couleur). */}
      <span class="maintenance-notice__wordmark" role="img" aria-label="SAV3GROUP">
        <img class="maintenance-notice__wordmark-part" src="/brand/wordmark.svg" alt="" width="2063" height="381" />
        <svg class="maintenance-notice__wordmark-part" viewBox="0 0 2180 381" width="2180" height="381" aria-hidden="true" focusable="false">
          <g class="maintenance-notice__group-letters">
            <path d="M400 42H90A48 48 0 0 0 42 90V291A48 48 0 0 0 90 339H310A48 48 0 0 0 358 291V200H210" />
            <path transform="translate(445 0)" d="M42 381V90A48 48 0 0 1 90 42H310A48 48 0 0 1 358 90V180A48 48 0 0 1 310 228H42" />
            <rect x="42" y="42" width="316" height="297" rx="48" transform="translate(890 0)" />
            <path transform="translate(1335 0)" d="M42 0V291A48 48 0 0 0 90 339H310A48 48 0 0 0 358 291V0" />
            <path transform="translate(1780 0)" d="M42 381V90A48 48 0 0 1 90 42H310A48 48 0 0 1 358 90V180A48 48 0 0 1 310 228H42" />
          </g>
          <polygon class="maintenance-notice__group-fill" points="665,270 757,270 845,381 750,381" />
        </svg>
      </span>
    </span>

    {/* Robot « en réparation » : dessin original, SVG en ligne, animations CSS. */}
    <svg
      class="mn-robot"
      viewBox="0 0 200 220"
      width="200"
      height="220"
      role="img"
      aria-label="Robot en cours de réparation / Robot under repair"
      focusable="false"
    >
      <ellipse class="mn-robot__shadow" cx="100" cy="212" rx="40" ry="5" />
      <g class="mn-robot__float">
        {/* Antenne */}
        <line class="mn-robot__stroke" x1="100" y1="34" x2="100" y2="21" />
        <circle class="mn-robot__bulb" cx="100" cy="16" r="5" />
        {/* Tête */}
        <rect class="mn-robot__ear" x="55" y="52" width="8" height="18" rx="3" />
        <rect class="mn-robot__ear" x="137" y="52" width="8" height="18" rx="3" />
        <rect class="mn-robot__part" x="62" y="34" width="76" height="54" rx="14" />
        <g class="mn-robot__eyes">
          <circle class="mn-robot__eye" cx="86" cy="60" r="6" />
          <circle class="mn-robot__eye" cx="114" cy="60" r="6" />
          <circle class="mn-robot__glint" cx="88" cy="58" r="1.8" />
          <circle class="mn-robot__glint" cx="116" cy="58" r="1.8" />
        </g>
        <path class="mn-robot__stroke" d="M90 74 Q100 81 110 74" />
        <rect class="mn-robot__part" x="90" y="87" width="20" height="12" rx="3" />
        {/* Jambes */}
        <rect class="mn-robot__part" x="70" y="176" width="16" height="20" rx="4" />
        <rect class="mn-robot__part" x="114" y="176" width="16" height="20" rx="4" />
        <rect class="mn-robot__part" x="63" y="193" width="30" height="11" rx="5.5" />
        <rect class="mn-robot__part" x="107" y="193" width="30" height="11" rx="5.5" />
        {/* Bras gauche (au repos) */}
        <path class="mn-robot__arm-line" d="M54 118 C38 126 34 146 40 158" />
        <path class="mn-robot__arm" d="M54 118 C38 126 34 146 40 158" />
        <circle class="mn-robot__part" cx="40" cy="160" r="6.5" />
        {/* Corps */}
        <rect class="mn-robot__part" x="52" y="98" width="96" height="80" rx="16" />
        {/* Panneau ouvert et engrenages */}
        <rect class="mn-robot__panel" x="68" y="112" width="64" height="56" rx="6" />
        <g class="mn-gear mn-gear--a">
          <circle class="mn-gear__teeth" cx="90" cy="136" r="12" stroke-width="6" stroke-dasharray="4.712 4.712" />
          <circle class="mn-gear__body" cx="90" cy="136" r="10.5" />
          <circle class="mn-gear__hole" cx="90" cy="136" r="3.5" />
        </g>
        <g class="mn-gear mn-gear--b">
          <circle class="mn-gear__teeth mn-gear__teeth--alt" cx="110" cy="150" r="8.5" stroke-width="5" stroke-dasharray="4.451 4.451" />
          <circle class="mn-gear__body mn-gear__body--alt" cx="110" cy="150" r="7" />
          <circle class="mn-gear__hole" cx="110" cy="150" r="2.5" />
        </g>
        <g class="mn-gear mn-gear--c">
          <circle class="mn-gear__teeth" cx="118" cy="132" r="6" stroke-width="4" stroke-dasharray="3.142 3.142" />
          <circle class="mn-gear__body" cx="118" cy="132" r="5" />
          <circle class="mn-gear__hole" cx="118" cy="132" r="2" />
        </g>
        <polygon class="mn-robot__door" points="68,112 55,105 55,175 68,168" />
        <circle class="mn-robot__screw" cx="59" cy="114" r="1.6" />
        <circle class="mn-robot__screw" cx="59" cy="166" r="1.6" />
        {/* Bras droit avec clé, pivote à l'épaule */}
        <g class="mn-robot__tool-arm">
          <path class="mn-robot__arm-line" d="M146 118 C168 124 172 150 152 156" />
          <path class="mn-robot__arm" d="M146 118 C168 124 172 150 152 156" />
          <line class="mn-robot__wrench" x1="148" y1="154" x2="130" y2="143" />
          <circle class="mn-robot__wrench-head" cx="126" cy="140" r="7.5" />
          <circle class="mn-robot__wrench-notch" cx="120.5" cy="136.5" r="3.6" />
          <circle class="mn-robot__part" cx="150" cy="156" r="6.5" />
        </g>
        {/* Étincelles */}
        <g transform="translate(114 127)">
          <path class="mn-spark mn-spark--1" d="M0-5 1.2-1.2 5 0 1.2 1.2 0 5-1.2 1.2-5 0-1.2-1.2Z" />
        </g>
        <g transform="translate(121 152)">
          <path class="mn-spark mn-spark--2" d="M0-4 1-1 4 0 1 1 0 4-1 1-4 0-1-1Z" />
        </g>
        <g transform="translate(133 131)">
          <path class="mn-spark mn-spark--3" d="M0-3.5 .9-.9 3.5 0 .9.9 0 3.5-.9.9-3.5 0-.9-.9Z" />
        </g>
      </g>
    </svg>

    <div class="maintenance-notice__messages">
      <h1 class="maintenance-notice__message" lang="fr">
        Nous mettons à jour nos informations. Merci pour votre patience.
      </h1>
      <span class="maintenance-notice__separator" aria-hidden="true"></span>
      <p class="maintenance-notice__message maintenance-notice__message--en" lang="en">
        We are updating our information. Thank you for your patience.
      </p>
    </div>
  </div>
</main>

<style>
  /* TEMPORARY MAINTENANCE NOTICE - remove after update */

  /* ---- Couleurs de l'avis : à ajuster ici (contraste WCAG AA vérifié sur le bleu ciel) ---- */
  .maintenance-notice {
    --mn-bg: #87ceeb; /* bleu ciel */
    --mn-bg-top: #d9f0fa; /* bleu plus clair, haut du dégradé */
    --mn-text: var(--navy-900); /* ≈ 9:1 sur #87ceeb */
    --mn-text-2: var(--navy-800); /* ≈ 7:1 sur #87ceeb */
    --mn-logo-group: #142c5f; /* « GROUP » : même marine que le logotype */
    --mn-border: rgb(11 30 66 / 0.3);
    --mn-robot-body: #f7fbfe;
    --mn-robot-shade: #dbe8f2;
    --mn-robot-line: var(--navy-800);
    --mn-robot-panel: var(--navy-950);
    --mn-robot-accent: var(--gold-500);
    --mn-robot-accent-2: var(--blue-300);
    --mn-robot-metal: #c6d3e0;
    --mn-spark: #fff3c4;
  }

  .maintenance-notice {
    flex: 1;
    display: grid;
    place-items: center;
    min-height: 100vh;
    min-height: 100dvh;
    padding: var(--gutter);
    background-color: var(--mn-bg);
    background-image: linear-gradient(to bottom, var(--mn-bg-top), var(--mn-bg) 70%);
    color: var(--mn-text);
  }
  .maintenance-notice__inner {
    display: grid;
    justify-items: center;
    gap: clamp(1rem, 3vw, 1.5rem);
    max-width: 34rem;
    text-align: center;
  }

  /* Logo */
  .maintenance-notice__logo {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
  }
  .maintenance-notice__symbol {
    width: min(62px, 18vw);
    height: auto;
  }
  .maintenance-notice__wordmark {
    --wm-h: clamp(1.4rem, 1rem + 1.6vw, 1.85rem);
    display: flex;
    gap: calc(var(--wm-h) * 0.16);
  }
  .maintenance-notice__wordmark-part {
    width: auto;
    height: var(--wm-h);
  }
  .maintenance-notice__group-letters {
    fill: none;
    stroke: var(--mn-logo-group);
    stroke-width: 84;
  }
  .maintenance-notice__group-fill {
    fill: var(--mn-logo-group);
  }

  /* Textes */
  .maintenance-notice__messages {
    display: grid;
    justify-items: center;
    gap: 0.85rem;
  }
  .maintenance-notice__message {
    color: var(--mn-text);
    font-size: var(--fs-lead);
    font-weight: 650;
    line-height: 1.5;
    letter-spacing: normal;
    text-wrap: balance;
  }
  .maintenance-notice__message--en {
    color: var(--mn-text-2);
    font-weight: 500;
  }
  .maintenance-notice__separator {
    width: 3rem;
    border-top: 1px solid var(--mn-border);
  }

  /* Robot */
  .mn-robot {
    display: block;
    width: min(200px, 60vw);
    height: auto;
    overflow: visible;
  }
  .mn-robot__shadow {
    fill: rgb(11 30 66 / 0.18);
  }
  .mn-robot__part {
    fill: var(--mn-robot-body);
    stroke: var(--mn-robot-line);
    stroke-width: 3;
  }
  .mn-robot__ear {
    fill: var(--mn-robot-accent-2);
    stroke: var(--mn-robot-line);
    stroke-width: 3;
  }
  .mn-robot__stroke {
    fill: none;
    stroke: var(--mn-robot-line);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .mn-robot__bulb {
    fill: var(--mn-robot-accent);
    stroke: var(--mn-robot-line);
    stroke-width: 2.5;
  }
  .mn-robot__eye {
    fill: var(--mn-robot-line);
  }
  .mn-robot__glint {
    fill: #fff;
  }
  .mn-robot__arm-line,
  .mn-robot__arm {
    fill: none;
    stroke-linecap: round;
  }
  .mn-robot__arm-line {
    stroke: var(--mn-robot-line);
    stroke-width: 12;
  }
  .mn-robot__arm {
    stroke: var(--mn-robot-body);
    stroke-width: 6;
  }
  .mn-robot__panel {
    fill: var(--mn-robot-panel);
    stroke: var(--mn-robot-line);
    stroke-width: 3;
  }
  .mn-robot__door {
    fill: var(--mn-robot-shade);
    stroke: var(--mn-robot-line);
    stroke-width: 3;
    stroke-linejoin: round;
  }
  .mn-robot__screw {
    fill: var(--mn-robot-line);
  }
  .mn-robot__wrench {
    stroke: var(--mn-robot-line);
    stroke-width: 5;
    stroke-linecap: round;
  }
  .mn-robot__wrench-head {
    fill: var(--mn-robot-metal);
    stroke: var(--mn-robot-line);
    stroke-width: 2.5;
  }
  .mn-robot__wrench-notch {
    fill: var(--mn-robot-panel);
  }
  .mn-gear__teeth {
    fill: none;
    stroke: var(--mn-robot-accent);
  }
  .mn-gear__teeth--alt {
    stroke: var(--mn-robot-accent-2);
  }
  .mn-gear__body {
    fill: var(--mn-robot-accent);
  }
  .mn-gear__body--alt {
    fill: var(--mn-robot-accent-2);
  }
  .mn-gear__hole {
    fill: var(--mn-robot-panel);
  }
  .mn-spark {
    fill: var(--mn-spark);
    stroke: var(--mn-robot-accent);
    stroke-width: 0.8;
    opacity: 0;
  }

  /* Petits écrans en hauteur : robot plus compact pour garder le bouton visible. */
  @media (max-height: 44em) {
    .mn-robot {
      width: min(150px, 45vw);
    }
    .maintenance-notice__symbol {
      width: min(48px, 14vw);
    }
    .maintenance-notice__wordmark {
      --wm-h: 1.3rem;
    }
  }

  /* Animations : uniquement si l'utilisateur n'a pas demandé de réduire les mouvements.
     Sinon, le robot reste statique (étincelles masquées). */
  @media (prefers-reduced-motion: no-preference) {
    .maintenance-notice__inner {
      animation: mn-fade-in 0.6s var(--ease) both;
    }
    .mn-gear,
    .mn-robot__eyes,
    .mn-robot__shadow,
    .mn-spark {
      transform-box: fill-box;
      transform-origin: center;
    }
    .mn-gear--a {
      animation: mn-spin 6s linear infinite;
    }
    .mn-gear--b {
      animation: mn-spin 4.25s linear infinite reverse;
    }
    .mn-gear--c {
      animation: mn-spin 3s linear infinite;
    }
    .mn-robot__float {
      animation: mn-float 3.2s ease-in-out infinite;
    }
    .mn-robot__shadow {
      animation: mn-shadow 3.2s ease-in-out infinite;
    }
    .mn-robot__eyes {
      animation: mn-blink 4.5s ease-in-out infinite;
    }
    .mn-robot__bulb {
      animation: mn-glow 1.6s ease-in-out infinite;
    }
    .mn-robot__tool-arm {
      transform-box: view-box;
      transform-origin: 146px 118px; /* épaule */
      animation: mn-work 0.9s ease-in-out infinite alternate;
    }
    .mn-spark {
      animation: mn-spark 1.8s ease-out infinite;
    }
    .mn-spark--2 {
      animation-delay: 0.6s;
    }
    .mn-spark--3 {
      animation-delay: 1.2s;
    }
  }

  @keyframes mn-fade-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }
  @keyframes mn-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes mn-float {
    50% {
      transform: translateY(-6px);
    }
  }
  @keyframes mn-shadow {
    50% {
      transform: scaleX(0.85);
      opacity: 0.7;
    }
  }
  @keyframes mn-blink {
    0%,
    44%,
    50%,
    100% {
      transform: scaleY(1);
    }
    47% {
      transform: scaleY(0.1);
    }
  }
  @keyframes mn-glow {
    50% {
      fill: #fff3c4;
    }
  }
  @keyframes mn-work {
    from {
      transform: rotate(-5deg);
    }
    to {
      transform: rotate(4deg);
    }
  }
  @keyframes mn-spark {
    0%,
    100% {
      opacity: 0;
      transform: scale(0.3);
    }
    12% {
      opacity: 1;
      transform: scale(1.15);
    }
    35% {
      opacity: 0;
      transform: scale(0.6);
    }
  }
</style>
