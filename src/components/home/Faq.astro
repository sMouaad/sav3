---
import Icon from '../Icon.astro';
import { useT } from '../../i18n';
import { path, type Lang } from '../../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const f = t.home.faq;
---

<section id={t.anchors.faq} class="section" aria-labelledby="faq-title">
  <div class="container faq">
    <div class="faq__head">
      <p class="eyebrow">{f.eyebrow}</p>
      <h2 id="faq-title">{f.title[0]}<br /><span class="accent">{f.title[1]}</span></h2>
      <p>{f.intro}</p>
      <a class="text-link" href={path('quote', lang)}>
        {t.common.requestQuote}
        <Icon name="arrowRight" />
      </a>
    </div>

    <div class="faq__list">
      {
        f.items.map((item, i) => (
          <details name="faq" open={i === 0}>
            <summary>
              <span>{item.q}</span>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: 2.5rem;
  }
  .faq__head > p:not(.eyebrow) {
    max-width: 22rem;
    margin: 1.25rem 0 1.5rem;
    color: var(--muted);
  }
  .faq__list {
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.4rem 0;
    color: var(--navy-900);
    font-size: clamp(1.02rem, 0.98rem + 0.2vw, 1.125rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--blue-600);
  }
  .faq__icon {
    position: relative;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border: 1.5px solid var(--line-strong);
    border-radius: 50%;
    transition:
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      transform 0.3s var(--ease);
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 0.8rem;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    translate: -50% -50%;
  }
  .faq__icon::after {
    rotate: 90deg;
    transition: rotate 0.3s var(--ease);
  }
  details[open] .faq__icon {
    border-color: var(--navy-800);
    background: var(--navy-800);
    color: #fff;
  }
  details[open] .faq__icon::after {
    rotate: 0deg;
  }
  details p {
    max-width: 44rem;
    padding: 0 3.5rem 1.5rem 0;
    color: var(--muted);
  }
  /* Ouverture fluide là où c'est pris en charge */
  @media (prefers-reduced-motion: no-preference) {
    @supports (interpolate-size: allow-keywords) {
      .faq__list {
        interpolate-size: allow-keywords;
      }
      details::details-content {
        height: 0;
        overflow: clip;
        transition:
          height 0.35s var(--ease),
          content-visibility 0.35s allow-discrete;
      }
      details[open]::details-content {
        height: auto;
      }
    }
  }
  @media (min-width: 60em) {
    .faq {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 5rem;
    }
    .faq__head {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      align-self: start;
    }
  }
</style>
