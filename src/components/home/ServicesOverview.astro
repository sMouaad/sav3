---
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import { useT } from '../../i18n';
import { path, type Lang } from '../../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const s = t.home.services;
const anchorFor = (key: string) => t.anchors[key as 'commercial' | 'residential' | 'specialized'];
---

<section class="section" aria-labelledby="services-title">
  <div class="container">
    <SectionHeading id="services-title" eyebrow={s.eyebrow} title={s.title} intro={s.intro} layout="split" />

    <ul class="cards" role="list">
      {
        t.categories.map((cat, i) => (
          <li class="card" data-reveal>
            <div class="card__top">
              <span class:list={['hex-badge', i === 0 && 'hex-badge--navy', i === 2 && 'hex-badge--gold']}>
                <Icon name={cat.icon} />
              </span>
              <span class="card__index" aria-hidden="true">0{i + 1}</span>
            </div>
            <h3>
              <a href={path('services', lang, anchorFor(cat.key))} class="card__link">
                {cat.name}
              </a>
            </h3>
            <p class="card__summary">{cat.summary}</p>
            <ul class="card__list" role="list">
              {cat.highlights.map((item) => (
                <li>
                  <Icon name="check" size={18} strokeWidth={2.25} />
                  {item}
                </li>
              ))}
            </ul>
            <span class="card__more" aria-hidden="true">
              {s.cardLink}
              <Icon name="arrowRight" size={18} />
            </span>
          </li>
        ))
      }
    </ul>

    <div class="footnote" data-reveal>
      <span class="hex-badge hex-badge--sm hex-badge--gold"><Icon name="clipboard" /></span>
      <p>{s.footnote}</p>
      <a class="text-link" href={path('quote', lang)}>
        {s.footnoteLink}
        <Icon name="arrowRight" />
      </a>
    </div>
  </div>
</section>

<style>
  .cards {
    display: grid;
    gap: 1.25rem;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--blue-300);
    box-shadow: var(--shadow-lg);
  }
  .card:focus-within {
    border-color: var(--blue-500);
  }
  .card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  .card__index {
    color: #8194ab; /* 3,1:1 sur blanc — seuil AA pour grand texte */
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .card h3 {
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
  }
  /* Toute la carte est cliquable, mais un seul lien est annoncé */
  .card__link {
    text-decoration: none;
  }
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .card__link:focus-visible {
    outline: none;
  }
  .card__link:focus-visible::after {
    outline: 3px solid var(--gold-500);
    outline-offset: 3px;
  }
  .card__summary {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .card__list {
    display: grid;
    gap: 0.55rem;
    margin: 1.5rem 0 2rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--line-strong);
    color: var(--ink-2);
    font-size: var(--fs-sm);
    font-weight: 550;
  }
  .card__list li {
    display: flex;
    gap: 0.6rem;
    line-height: 1.45;
  }
  .card__list :global(svg) {
    flex: none;
    color: var(--blue-600);
    margin-top: 0.05rem;
  }
  .card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: auto;
    color: var(--blue-600);
    font-size: var(--fs-sm);
    font-weight: 700;
  }
  .card__more :global(svg) {
    transition: transform 0.25s var(--ease);
  }
  .card:hover .card__more :global(svg) {
    transform: translateX(4px);
  }

  .footnote {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
    margin-top: 1.5rem;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius);
    background: var(--surface-2);
    border: 1px solid var(--line);
  }
  .footnote p {
    flex: 1 1 18rem;
    color: var(--ink-2);
    font-size: var(--fs-sm);
  }

  @media (min-width: 60em) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
