---
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import heroImage from '../../assets/photos/nettoyage-fenetre.jpg';
import { useT } from '../../i18n';
import { path, type Lang } from '../../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const h = t.home.hero;
---

<section class="hero" aria-labelledby="hero-title">
  <svg class="hero__pattern" aria-hidden="true" viewBox="0 0 600 600" fill="none">
    <path d="M300 20 542 160v280L300 580 58 440V160Z" stroke="currentColor" stroke-width="1.5"></path>
    <path d="M300 90 482 195v210L300 510 118 405V195Z" stroke="currentColor" stroke-width="1.5"></path>
    <path d="M300 160 422 230v140L300 440 178 370V230Z" stroke="currentColor" stroke-width="1.5"></path>
  </svg>

  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__eyebrow"><span class="pulse" aria-hidden="true"></span>{h.eyebrow}</p>
      <h1 id="hero-title">
        <span class="line">{h.title[0]} <span class="accent">{h.title[1]}</span></span>
        <span class="line">{h.title[2]} <span class="underline">{h.title[3]}</span></span>
      </h1>
      <p class="hero__lead">{h.lead}</p>
      <div class="hero__actions">
        <a class="btn btn--lg" href={path('quote', lang)}>
          {t.common.requestQuote}
          <Icon name="arrowRight" />
        </a>
        <a class="btn btn--ghost btn--lg" href={path('services', lang)}>{h.secondary}</a>
      </div>
      <ul class="hero__points" role="list">
        {
          h.points.map((point) => (
            <li>
              <Icon name="checkCircle" size={18} />
              {point}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__media">
      <div class="hero__frame">
        <Picture
          src={heroImage}
          alt={h.imageAlt}
          width={1280}
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 64em) 42vw, (min-width: 40em) 80vw, 100vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
          class="hero__img"
        />
      </div>
      <div class="hero__card">
        <span class="hex-badge hex-badge--navy hex-badge--sm"><Icon name="shield" /></span>
        <div>
          <p class="hero__card-label">{h.cardLabel}</p>
          <p class="hero__card-text">{h.cardText} <strong>{h.cardStrong}</strong></p>
        </div>
      </div>
      <p class="hero__chip"><Icon name="mapPin" size={16} />{h.chip}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 6vw, 5.5rem) clamp(3.5rem, 7vw, 6rem);
    background:
      radial-gradient(55rem 35rem at 90% 0%, var(--blue-100) 0%, transparent 60%),
      linear-gradient(180deg, var(--surface) 0%, var(--surface-2) 100%);
  }
  .hero__pattern {
    position: absolute;
    top: -6rem;
    right: -9rem;
    width: 42rem;
    color: var(--blue-500);
    opacity: 0.18;
    pointer-events: none;
  }
  .hero__grid {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.75);
    color: var(--navy-800);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    box-shadow: var(--shadow-sm);
  }
  .pulse {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--gold-500);
  }
  @media (prefers-reduced-motion: no-preference) {
    .pulse::after {
      content: '';
      position: absolute;
      inset: -4px;
      border-radius: 50%;
      border: 2px solid var(--gold-500);
      animation: pulse 2.4s var(--ease) infinite;
    }
  }
  @keyframes pulse {
    from {
      opacity: 0.8;
      transform: scale(0.6);
    }
    to {
      opacity: 0;
      transform: scale(1.8);
    }
  }
  h1 .line {
    display: block;
  }
  .underline {
    text-decoration: underline;
    text-decoration-color: var(--gold-500);
    text-decoration-thickness: 0.09em;
    text-underline-offset: 0.12em;
    text-decoration-skip-ink: none;
  }
  .hero__lead {
    max-width: 34rem;
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: var(--fs-lead);
    line-height: 1.7;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .hero__points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    margin-top: 2.25rem;
    color: var(--ink-2);
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  .hero__points li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .hero__points :global(svg) {
    color: var(--blue-600);
  }

  .hero__media {
    position: relative;
    padding: 0 0 2.5rem;
  }
  .hero__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-xl);
    background: var(--surface-3);
    box-shadow: var(--shadow-lg);
  }
  .hero__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.25);
    background: linear-gradient(180deg, transparent 55%, rgb(6 18 43 / 0.25));
  }
  .hero__frame :global(picture) {
    width: 100%;
    height: 100%;
  }
  .hero__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 38% 45%;
  }
  .hero__card {
    position: absolute;
    left: clamp(-1.5rem, -2vw, 0rem);
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    max-width: min(20rem, 85%);
    padding: 1rem 1.15rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.96);
    box-shadow: var(--shadow-md);
  }
  .hero__card-label {
    color: var(--blue-600);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .hero__card-text {
    color: var(--ink-2);
    font-size: var(--fs-sm);
    line-height: 1.45;
  }
  .hero__card-text strong {
    color: var(--navy-900);
  }
  .hero__chip {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    background: rgb(11 30 66 / 0.78);
    color: #fff;
    font-size: var(--fs-xs);
    font-weight: 700;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  .hero__chip :global(svg) {
    color: var(--gold-500);
  }

  @media (min-width: 64em) {
    .hero__grid {
      grid-template-columns: 1.08fr 0.92fr;
    }
    .hero__frame {
      aspect-ratio: 4 / 5;
    }
    .hero__media {
      padding: 0 0 0 1.5rem;
    }
    .hero__card {
      left: -1rem;
      bottom: 2.5rem;
    }
  }
  @media (max-width: 30em) {
    .hero__actions .btn {
      width: 100%;
    }
  }
</style>
