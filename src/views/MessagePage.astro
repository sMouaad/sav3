---
/** Page de message simple : confirmation d'envoi (merci) ou erreur 404. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { useT } from '../i18n';
import { path, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  kind: 'thanks' | 'notFound';
}
const { lang, kind } = Astro.props;
const t = useT(lang);
const m = kind === 'thanks' ? t.thanks : t.notFound;
const secondary = kind === 'thanks' ? { href: path('services', lang), label: t.thanks.secondary } : { href: path('quote', lang), label: t.common.requestQuote };
---

<BaseLayout lang={lang} routeKey={kind} title={m.title} description={m.description} noindex>
  <section class="message">
    <svg class="message__pattern" aria-hidden="true" viewBox="0 0 600 600" fill="none">
      <path d="M300 20 542 160v280L300 580 58 440V160Z" stroke="currentColor" stroke-width="1.5"></path>
      <path d="M300 110 464 205v190L300 490 136 395V205Z" stroke="currentColor" stroke-width="1.5"></path>
    </svg>
    <div class="container message__inner">
      <span class:list={['hex-badge', kind === 'thanks' ? 'hex-badge--navy' : 'hex-badge--gold', 'message__badge']}>
        <Icon name={kind === 'thanks' ? 'check' : 'mapPin'} strokeWidth={2.25} />
      </span>
      <p class="eyebrow">{m.eyebrow}</p>
      <h1>{m.heading}</h1>
      <p class="message__text">{m.text}</p>
      <div class="message__actions">
        <a class="btn btn--lg" href={path('home', lang)}>{t.common.backHome}</a>
        <a class="btn btn--ghost btn--lg" href={secondary.href}>
          {secondary.label}
          <Icon name="arrowRight" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .message {
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    min-height: 70vh;
    padding-block: clamp(4rem, 10vw, 7rem);
    background:
      radial-gradient(45rem 30rem at 50% 0%, var(--blue-100), transparent 60%),
      linear-gradient(180deg, var(--surface), var(--surface-2));
    text-align: center;
  }
  .message__pattern {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 44rem;
    translate: -50% -50%;
    color: var(--blue-500);
    opacity: 0.14;
    pointer-events: none;
  }
  .message__inner {
    position: relative;
    display: grid;
    justify-items: center;
    max-width: 44rem;
  }
  .message__badge {
    width: 4.5rem;
    height: 5rem;
    margin-bottom: 1.75rem;
  }
  .message__badge :global(svg) {
    width: 2rem;
    height: 2rem;
  }
  h1 {
    font-size: clamp(2.1rem, 1.5rem + 2.6vw, 3.5rem);
  }
  .message__text {
    max-width: 34rem;
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: var(--fs-lead);
  }
  .message__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
</style>
